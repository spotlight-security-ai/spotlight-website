---
// Site footer — column structure mirrors the WP "Site Footer" component:
// Platform · Company · Partners · Contact
import { url } from '../lib/url';

const cols = [
  {
    title: 'Platform',
    links: [
      { label: 'How it Works', href: url('/platform/') },
      { label: 'Endpoint Detection', href: url('/platform/#detection') },
      { label: 'One-Click Remediation', href: url('/platform/#remediation') },
      { label: 'Reporting', href: url('/platform/#reporting') },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'About', href: url('/about/') },
      { label: 'Industries', href: url('/industries/') },
      { label: 'Pricing', href: url('/#pricing') },
    ],
  },
  {
    title: 'Partners',
    links: [
      { label: 'OpenAI Cybersecurity Grant', href: '#' },
      { label: 'MassChallenge', href: '#' },
      { label: 'Become a Partner', href: '#' },
    ],
  },
  {
    title: 'Contact',
    links: [
      { label: 'Book a Demo', href: 'https://docs.google.com/forms/d/e/1FAIpQLSfgc0ZEiZ9nkrDfpylJCwfrl7lfc9scwQ3iBBFHbF8rIvGD0w/viewform' },
      { label: 'hello@spotlightsecurity.ai', href: 'mailto:hello@spotlightsecurity.ai' },
    ],
  },
];
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="brand" href={url('/')} aria-label="Spotlight Security — home">
        <span class="brand-dot" aria-hidden="true"></span>
        <span class="brand-word">Spotlight</span>
      </a>
      <p class="footer-tagline">
        Agentic OT/IT cybersecurity. Find it, explain it, fix it — without
        professional services.
      </p>
    </div>

    {cols.map((col) => (
      <nav class="footer-col" aria-label={col.title}>
        <h4>{col.title}</h4>
        <ul>
          {col.links.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </nav>
    ))}
  </div>

  <div class="container footer-bottom">
    <span>&copy; {year} Spotlight Security. All rights reserved.</span>
    <a href={url('/privacy/')}>Privacy Policy</a>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--box-border);
    background: #0a0c1acc;
    padding-top: 64px;
    margin-top: 40px;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr repeat(4, 1fr);
    gap: 40px;
  }
  .brand {
    display: inline-flex; align-items: center; gap: 0.6rem;
    font-family: var(--font-display); font-weight: 700;
    font-size: 1.25rem; color: var(--white);
  }
  .brand-dot {
    width: 13px; height: 13px; border-radius: 50%;
    background: var(--brand-gradient);
    box-shadow: 0 0 0 4px #ff713026, 0 0 16px #db332daa;
  }
  .footer-tagline { margin-top: 1rem; max-width: 30ch; color: var(--muted); font-size: 0.95rem; }
  .footer-col h4 {
    font-family: var(--font-mono);
    font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.12em;
    color: var(--light-white); margin-bottom: 1rem;
  }
  .footer-col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
  .footer-col a { color: var(--muted); font-size: 0.92rem; transition: color 0.15s ease; }
  .footer-col a:hover { color: var(--white); }

  .footer-bottom {
    display: flex; justify-content: space-between; align-items: center;
    padding-block: 28px; margin-top: 48px;
    border-top: 1px solid var(--box-border);
    font-size: 0.85rem; color: var(--light-white);
  }
  .footer-bottom a { color: var(--light-white); }
  .footer-bottom a:hover { color: var(--white); }

  @media (max-width: 860px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
    .footer-brand { grid-column: 1 / -1; }
    .footer-bottom { flex-direction: column; gap: 0.75rem; }
  }
</style>
