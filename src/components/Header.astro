---
// Site header — shared across all pages.
// CTA links to the live "Book a Demo" Google Form (from the WP export).
import { url } from '../lib/url';

const DEMO_URL =
  'https://docs.google.com/forms/d/e/1FAIpQLSfgc0ZEiZ9nkrDfpylJCwfrl7lfc9scwQ3iBBFHbF8rIvGD0w/viewform';

const nav = [
  { label: 'Platform', href: url('/platform/') },
  { label: 'Industries', href: url('/industries/') },
  { label: 'About', href: url('/about/') },
  { label: 'Pricing', href: url('/#pricing') },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={url('/')} aria-label="Spotlight Security — home">
      <!-- Placeholder wordmark; swap for /brand/2SS_Horizontal_white.png -->
      <span class="brand-dot" aria-hidden="true"></span>
      <span class="brand-word">Spotlight</span>
    </a>

    <nav class="nav" aria-label="Primary">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="header-actions">
      <a class="btn btn-primary" href={DEMO_URL} target="_blank" rel="noopener">
        Book a Demo
      </a>
      <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <nav class="mobile-nav" aria-label="Mobile">
    {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    <a class="btn btn-primary" href={DEMO_URL} target="_blank" rel="noopener">Book a Demo</a>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(14px);
    background: #0b0d1fcc;
    border-bottom: 1px solid var(--box-border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 68px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.28rem;
    color: var(--white);
    letter-spacing: -0.02em;
  }
  .brand-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--brand-gradient);
    box-shadow: 0 0 0 4px #ff713026, 0 0 18px #db332daa;
  }
  .nav {
    display: flex;
    gap: 2rem;
    font-size: 0.95rem;
  }
  .nav a { color: var(--muted); transition: color 0.15s ease; }
  .nav a:hover { color: var(--white); }

  .header-actions { display: flex; align-items: center; gap: 0.75rem; }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: 0;
    cursor: pointer;
    padding: 6px;
  }
  .nav-toggle span {
    width: 22px; height: 2px; background: var(--white); border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .mobile-nav {
    display: none;
    flex-direction: column;
    gap: 0.25rem;
    padding: 12px 24px 20px;
    border-top: 1px solid var(--box-border);
    background: #0b0d1ff2;
  }
  .mobile-nav a { color: var(--text); padding: 0.6rem 0; }
  .mobile-nav .btn { margin-top: 0.5rem; }

  @media (max-width: 860px) {
    .nav { display: none; }
    .header-actions > .btn { display: none; }
    .nav-toggle { display: flex; }
    .mobile-nav.open { display: flex; }
  }
</style>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const menu = document.querySelector('.mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(!!open));
  });
</script>
